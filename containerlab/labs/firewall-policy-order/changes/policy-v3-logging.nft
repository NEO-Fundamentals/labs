# fw: policy v3 = v2 plus logging at the cleanup rule (exercise 6). eth1 = inside, eth2 = outside, eth3 = dmz.
# Every denied TCP flow is recorded in the set "denied" (source . destination . port, with a packet counter, kept 1 h):
# the lab's drop record, which works everywhere. The log rule also writes one kernel log line per denied packet; the
# host shows those lines only after  sudo sysctl -w net.netfilter.nf_log_all_netns=1  (see the README).
table inet fw
delete table inet fw
table inet fw {
    set web_servers {
        type ipv4_addr
        elements = { 10.14.3.30 }
    }
    set denied {
        type ipv4_addr . ipv4_addr . inet_service
        flags dynamic,timeout
        timeout 1h
        counter
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related counter accept comment "replies"
        iifname "eth1" oifname "eth2" ct state new counter accept comment "R10 inside -> outside"
        iifname "eth2" ip saddr 10.14.2.20 oifname "eth3" tcp dport 80 counter drop comment "R30 block host-b from the dmz web"
        oifname "eth3" ip daddr @web_servers tcp dport { 80, 443 } ct state new counter accept comment "R20 any -> web servers"
        meta l4proto tcp update @denied { ip saddr . ip daddr . tcp dport } comment "cleanup: record the flow"
        log prefix "fw14-deny " counter comment "cleanup: log, then default deny"
    }
}
