set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "access port, VLAN 10"
set / interface ethernet-1/1 subinterface 0 type bridged
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "access port, VLAN 30"
set / interface ethernet-1/2 subinterface 0 type bridged
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 description "trunk: VLAN 30 tagged, VLAN 10 native (untagged)"
set / interface ethernet-1/3 vlan-tagging true
set / interface ethernet-1/3 subinterface 1 type bridged
set / interface ethernet-1/3 subinterface 1 admin-state enable
set / interface ethernet-1/3 subinterface 1 description "native VLAN 10, untagged"
set / interface ethernet-1/3 subinterface 1 vlan encap untagged
set / interface ethernet-1/3 subinterface 30 type bridged
set / interface ethernet-1/3 subinterface 30 admin-state enable
set / interface ethernet-1/3 subinterface 30 description "VLAN 30, tagged"
set / interface ethernet-1/3 subinterface 30 vlan encap single-tagged vlan-id 30
set / network-instance vlan10 type mac-vrf
set / network-instance vlan10 admin-state enable
set / network-instance vlan10 description "VLAN 10"
set / network-instance vlan10 interface ethernet-1/1.0
set / network-instance vlan10 interface ethernet-1/3.1
set / network-instance vlan30 type mac-vrf
set / network-instance vlan30 admin-state enable
set / network-instance vlan30 description "VLAN 30"
set / network-instance vlan30 interface ethernet-1/2.0
set / network-instance vlan30 interface ethernet-1/3.30
