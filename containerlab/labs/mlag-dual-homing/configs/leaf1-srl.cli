set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to h1 (bond0 member 1): lag1 member"
set / interface ethernet-1/1 ethernet aggregate-id lag1
set / interface lag1 admin-state enable
set / interface lag1 description "h1's bundle: one member here, one on leaf2; same LACP system ID on both leaves"
set / interface lag1 lag lag-type lacp
set / interface lag1 lag min-links 1
set / interface lag1 lag lacp interval FAST
set / interface lag1 lag lacp lacp-mode ACTIVE
set / interface lag1 lag lacp admin-key 44
set / interface lag1 lag lacp system-id-mac 02:00:00:44:00:aa
set / interface lag1 lag lacp system-priority 32768
set / interface lag1 subinterface 0 type bridged
set / interface lag1 subinterface 0 admin-state enable
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "access port to h2"
set / interface ethernet-1/2 subinterface 0 type bridged
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 description "link to leaf2: underlay, BGP EVPN and VXLAN"
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 10.44.12.1/30
set / interface system0 admin-state enable
set / interface system0 subinterface 0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.44.255.1/32
set / network-instance default type default
set / network-instance default admin-state enable
set / network-instance default interface ethernet-1/3.0
set / network-instance default interface system0.0
set / network-instance default next-hop-groups group to-leaf2 nexthop 1 ip-address 10.44.12.2
set / network-instance default static-routes route 10.44.255.2/32 next-hop-group to-leaf2
set / network-instance default protocols bgp autonomous-system 65044
set / network-instance default protocols bgp router-id 10.44.255.1
set / network-instance default protocols bgp afi-safi evpn admin-state enable
set / network-instance default protocols bgp group leaves peer-as 65044
set / network-instance default protocols bgp group leaves afi-safi evpn admin-state enable
set / network-instance default protocols bgp group leaves afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group leaves transport local-address 10.44.255.1
set / network-instance default protocols bgp neighbor 10.44.255.2 peer-group leaves
set / tunnel-interface vxlan1 vxlan-interface 1 type bridged
set / tunnel-interface vxlan1 vxlan-interface 1 ingress vni 10044
set / tunnel-interface vxlan1 vxlan-interface 1 egress source-ip use-system-ipv4-address
set / network-instance lan type mac-vrf
set / network-instance lan admin-state enable
set / network-instance lan description "one Layer 2 segment over both leaves (EVPN, VXLAN VNI 10044)"
set / network-instance lan interface lag1.0
set / network-instance lan interface ethernet-1/2.0
set / network-instance lan vxlan-interface vxlan1.1
set / network-instance lan protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance lan protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.1
set / network-instance lan protocols bgp-evpn bgp-instance 1 evi 44
set / network-instance lan protocols bgp-evpn bgp-instance 1 ecmp 2
set / network-instance lan protocols bgp-vpn bgp-instance 1 route-target export-rt target:65044:44
set / network-instance lan protocols bgp-vpn bgp-instance 1 route-target import-rt target:65044:44
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment es-h1 admin-state enable
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment es-h1 esi 00:44:44:44:44:44:44:44:44:01
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment es-h1 multi-homing-mode all-active
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment es-h1 interface lag1
set / system network-instance protocols bgp-vpn bgp-instance 1
