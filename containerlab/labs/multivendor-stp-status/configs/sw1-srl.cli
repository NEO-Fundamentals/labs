set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to sw2 (SR Linux)"
set / interface ethernet-1/1 subinterface 0 type bridged
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 bridge-table stp admin-state enable
set / interface ethernet-1/1 subinterface 0 bridge-table stp path-cost 2000
set / interface ethernet-1/1 subinterface 0 bridge-table stp link-type P2P
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "to sw3 (Linux bridge)"
set / interface ethernet-1/2 subinterface 0 type bridged
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 bridge-table stp admin-state enable
set / interface ethernet-1/2 subinterface 0 bridge-table stp path-cost 2000
set / interface ethernet-1/2 subinterface 0 bridge-table stp link-type P2P
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 description "to h1 (host port)"
set / interface ethernet-1/3 subinterface 0 type bridged
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface ethernet-1/3 subinterface 0 bridge-table stp admin-state enable
set / interface ethernet-1/3 subinterface 0 bridge-table stp edge-port EDGE_ENABLE
set / network-instance lan type mac-vrf
set / network-instance lan admin-state enable
set / network-instance lan description "one LAN, 10.36.0.0/24"
set / network-instance lan interface ethernet-1/1.0
set / network-instance lan interface ethernet-1/2.0
set / network-instance lan interface ethernet-1/3.0
set / network-instance lan protocols stp admin-state enable
set / network-instance lan protocols stp bridge-priority 4096
set / network-instance lan protocols stp bridge-address 02:00:00:36:00:01
set / network-instance lan protocols stp hello-time 1
set / network-instance lan protocols stp max-age 6
set / network-instance lan protocols stp forward-delay 4
