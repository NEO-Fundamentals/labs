set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "transit to r1"
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.0.12.2/30
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "host-2 LAN"
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.2.2.1/24
set / network-instance default type default
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default next-hop-groups group to-r1 nexthop 1 ip-address 10.0.12.1
set / network-instance default static-routes route 10.1.1.0/24 next-hop-group to-r1
set / network-instance default static-routes route 10.0.99.0/30 next-hop-group to-r1
