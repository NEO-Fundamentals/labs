# fw at deploy: no filtering (forward policy accept) and an empty NAT table: fw only routes.
table inet fw
delete table inet fw
table inet fw {
    chain forward {
        type filter hook forward priority filter; policy accept;
        counter comment "no filtering: fw only routes"
    }
}
table ip fw_nat
delete table ip fw_nat
table ip fw_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
    }
}
