# Exercise 6: plus hairpin NAT: inside clients that reach an inside server through the public address are also
# source-NATed (to fw's inside address 10.15.1.1), so the server answers through fw.
table ip fw_nat
delete table ip fw_nat
table ip fw_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "eth2" tcp dport 8080 counter dnat to 10.15.3.30:80 comment "port forward 10.15.2.1:8080 -> host-c:80"
        tcp dport 8081 ip daddr 10.15.2.1 counter dnat to 10.15.1.40:8080 comment "port forward 10.15.2.1:8081 -> host-d:8080 (any source)"
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "eth2" counter masquerade comment "inside -> outside: hide behind 10.15.2.1"
        oifname "eth1" ip saddr 10.15.1.0/24 ct status dnat counter masquerade comment "hairpin: inside -> inside via the public address"
    }
}
