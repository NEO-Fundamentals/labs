# Source NAT plus a port forward (destination NAT): 10.15.2.1:8080 arriving on eth2 goes to host-c 10.15.3.30:80.
table ip fw_nat
delete table ip fw_nat
table ip fw_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "eth2" tcp dport 8080 counter dnat to 10.15.3.30:80 comment "port forward 10.15.2.1:8080 -> host-c:80"
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "eth2" counter masquerade comment "inside -> outside: hide behind 10.15.2.1"
    }
}
