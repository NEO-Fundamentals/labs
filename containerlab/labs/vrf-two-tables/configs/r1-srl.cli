set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to h1 (VRF alpha)"
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.12.1.1/24
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "to h2 (VRF alpha)"
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.12.2.1/24
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 description "to h3 (VRF beta)"
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 10.12.3.1/24
set / network-instance alpha type ip-vrf
set / network-instance alpha description "VRF alpha: h1 and h2"
set / network-instance alpha interface ethernet-1/1.0
set / network-instance alpha interface ethernet-1/2.0
set / network-instance beta type ip-vrf
set / network-instance beta description "VRF beta: h3"
set / network-instance beta interface ethernet-1/3.0
