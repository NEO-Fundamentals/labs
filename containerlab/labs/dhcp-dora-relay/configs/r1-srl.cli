set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to the DHCP server"
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.42.0.2/30
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "LAN B, client-2"
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.42.20.1/24
set / interface ethernet-1/2 subinterface 0 ipv4 dhcp-relay admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 dhcp-relay server [ 10.42.0.1 ]
set / interface ethernet-1/2 subinterface 0 ipv4 dhcp-relay gi-address 10.42.20.1
set / interface ethernet-1/2 subinterface 0 ipv4 dhcp-relay use-gi-addr-as-src-ip-addr true
set / network-instance default type default
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default next-hop-groups group to-srv nexthop 1 ip-address 10.42.0.1
set / network-instance default static-routes route 10.42.10.0/24 next-hop-group to-srv
