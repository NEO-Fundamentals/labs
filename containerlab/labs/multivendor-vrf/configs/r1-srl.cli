set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to site-a (VRF red)"
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.39.100.1/24
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "to site-b (VRF blue)"
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.39.100.1/24
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 description "to r2 eth1 (VRF red)"
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 10.39.12.1/30
set / interface ethernet-1/4 admin-state enable
set / interface ethernet-1/4 description "to r2 eth2 (VRF blue)"
set / interface ethernet-1/4 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/4 subinterface 0 ipv4 address 10.39.12.1/30
set / network-instance red type ip-vrf
set / network-instance red description "VRF RED: site-a and site-c"
set / network-instance red interface ethernet-1/1.0
set / network-instance red interface ethernet-1/3.0
set / network-instance red next-hop-groups group to-r2 nexthop 1 ip-address 10.39.12.2
set / network-instance red static-routes route 10.39.200.0/24 next-hop-group to-r2
set / network-instance blue type ip-vrf
set / network-instance blue description "VRF BLUE: site-b and site-d"
set / network-instance blue interface ethernet-1/2.0
set / network-instance blue interface ethernet-1/4.0
set / network-instance blue next-hop-groups group to-r2 nexthop 1 ip-address 10.39.12.2
set / network-instance blue static-routes route 10.39.200.0/24 next-hop-group to-r2
